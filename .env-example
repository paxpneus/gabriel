PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=osteoteca_banco
DB_USER=postgres
DB_PASS=suasenha

REDIS_PORT=6379
REDIS_HOST=127.0.0.1
# REDIS_USERNAME=redis
# REDIS_PASSWORD=redis
REDIS_DB=0

# BULL_BOARD_PATH=

# Coletor diário do CSV de movimentações de estoque da Bling
# Em produção, mantenha MAX_PAGES e MAX_PRODUCTS em 0 para obter uma
# extração completa e registrar a fonte no banco.
BLING_EMAIL=
BLING_PASSWORD=
BLING_HEADLESS=true
BLING_INTEGRATION_ID=
BLING_DEPOSITO_IDS=
STOCK_MOVEMENTS_CSV_DIR=/app/data/stock-movements
MAX_PAGES=0
MAX_PRODUCTS=0
PAGE_DELAY_MS=400
PRODUCT_DELAY_MS=1500
BATCH_SIZE=200
RESUME=true

# Após uma extração completa e registrada, executa o populate automaticamente.
# Comece com dry-run; altere para false somente depois de validar os logs.
BLING_STOCK_MOVEMENTS_AUTO_POPULATE=false
BLING_STOCK_MOVEMENTS_POPULATE_DRY_RUN=true

# Deploy blue-green (serviço `deployer`) - ver scripts/deployer/README.md
DEPLOY_REPO_URL=https://github.com/paxpneus/gabriel.git
DEPLOY_GIT_BRANCH=main
# Precisa ser exatamente o nome da stack no Portainer, senão o deploy sobe
# um project/stack duplicado em vez de atualizar os containers existentes.
COMPOSE_PROJECT_NAME=
DEPLOY_WEBHOOK_SECRET=
DEPLOY_HEALTH_TIMEOUT=60
